{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/reader",
      "destination": "/reader/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhook-pagarme/",
      "destination": "/api/webhook-pagarme"
    },
    {
      "source": "/edicao-especial",
      "destination": "/"
    },
    {
      "source": "/edicao-especial/:path*",
      "destination": "/"
    }
  ]
}
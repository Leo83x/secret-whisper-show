{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/reader",
      "destination": "/reader/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/edicao-especial",
      "destination": "/"
    },
    {
      "source": "/edicao-especial/:path*",
      "destination": "/"
    }
  ]
}